# ══════════════════════════════════════════════════════════════════════════════
# Ask-the-Web — environment template.  Copy to .env and fill values.
# NEVER commit .env (git-ignored). See SECURITY.md.
# ══════════════════════════════════════════════════════════════════════════════

# ── LLM providers (at least one REQUIRED) ────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Model tiers: default = synthesis quality, fast = routing/classification
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini

# Ordered fallback chain (ADR-002). First healthy provider wins.
LLM_PROVIDER_ORDER=openai,anthropic

# ── Search providers (at least one REQUIRED) ─────────────────────────────────
TAVILY_API_KEY=tvly-...
SERPAPI_API_KEY=
SEARCH_PROVIDER=tavily
SEARCH_PROVIDER_ORDER=tavily,serpapi

# ── Redis (response cache, rate limits, singleflight locks) ──────────────────
# Optional in local dev — cache fails open without it.
REDIS_URL=redis://localhost:6379/0

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO
API_VERSION=2.0.0
MAX_AGENT_ITERATIONS=10
MAX_TOKENS_PER_RESPONSE=4096
CONTEXT_WINDOW_LIMIT=120000

# ── Request budgets (ADR-005) — the anti-runaway guard ──────────────────────
BUDGET_MAX_INPUT_TOKENS=120000
BUDGET_MAX_OUTPUT_TOKENS=16000
BUDGET_MAX_TOOL_CALLS=25
BUDGET_MAX_STEPS=12
BUDGET_DEADLINE_S=45

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100       # global per IP
RATE_LIMIT_WINDOW=60
RATE_LIMIT_PER_USER_REQUESTS=30

# ── Timeouts (seconds) ───────────────────────────────────────────────────────
LLM_TIMEOUT=60
SEARCH_TIMEOUT=15
SCRAPE_TIMEOUT=20
TOOL_TIMEOUT_S=15

# ── Tool safety (FM-08 / FM-09) ──────────────────────────────────────────────
MAX_RESPONSE_BYTES=3000000    # fetch body cap (3 MB)
MAX_TOOL_RESULT_CHARS=8000    # truncation before context injection
MAX_PARALLEL_TOOL_CALLS=5

# ── Response cache (ADR-003) ─────────────────────────────────────────────────
CACHE_TTL_S=3600
CACHE_STALE_S=600             # stale-while-revalidate window
CACHE_JITTER_RATIO=0.3
CACHE_LOCK_TTL_MS=8000        # singleflight lock TTL
CACHE_WAIT_MS=5000            # follower wait budget

# ── Outbound HTTP pool ───────────────────────────────────────────────────────
HTTP_POOL_MAX_CONNECTIONS=100
HTTP_POOL_MAX_KEEPALIVE=20
