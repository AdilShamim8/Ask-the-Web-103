# Keep Docker images small and build context fast.
# Anything not needed at runtime inside the container belongs here.

# VCS
.git
.gitignore
.gitattributes
.github

# Docs (large, not needed in image)
docs/
*.md
!README.md
Tutorial-103.md

# NOTE (fixed 2026-10-16): LICENSE is no longer excluded. pyproject
# declares license = { file = "LICENSE" } and hatchling hard-fails the
# build with "License file does not exist" when it is missing from the
# context — this silently broke every docker-build CI check.

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Dev & test tooling
tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.pre-commit-config.yaml
Makefile

# Local env & secrets (injected via runtime secrets, never baked in)
.env
.env.*
*.pem
*.key

# Infra manifests (applied by CI/CD, not the app container)
deploy/
docker-compose*.yml

# OS / IDE
.DS_Store
.idea/
.vscode/
